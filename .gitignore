# ============================================================
# CODE AND CONFIGURATION ONLY -- no data files, ever.
# Strategy: ignore everything, then re-include known source types.
# Anything not listed below is excluded by default.
# ============================================================

# 1) Ignore everything...
*
# 2) ...but still descend into subdirectories
!*/

# ---- Code ----
!*.py
!*.pyx
!*.ipynb
!*.R
!*.r
!*.Rmd
!*.sh
!*.bash
!*.pl
!*.jl
!*.cpp
!*.c
!*.h
!*.hpp
!*.js
!*.sql
!*.smk
!Snakefile
!Makefile
!Dockerfile
!*.nf

# ---- Configuration ----
!*.yaml
!*.yml
!*.toml
!*.cfg
!*.ini
!*.conf
!*.json
!.gitignore
!.gitattributes
!.dockerignore
!environment.yml
!requirements*.txt
!setup.py
!setup.cfg
!pyproject.toml
!MANIFEST.in
!DESCRIPTION
!NAMESPACE

# ---- Documentation ----
!*.md
!*.rst
!README*
!LICENSE*
!CITATION*

# ---- Re-exclude cruft that would otherwise slip through ----
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.virtual_documents/
wandb/
mlruns/
lightning_logs/

# ---- Small INPUT tables that the pipeline reads (outputs stay excluded) ----
# The allowlist above drops every .csv, which is right for the multi-hundred-MB
# derived tables but wrong for these, which are inputs with no code that
# regenerates them. Without them a fresh clone cannot run 00_Prepare_data.
!Src/ComboScreen/Doxo_1_differentiated.DEGs.csv

# ---- Local editor / tool configuration (machine-specific) ----
.claude/settings.local.json
**/.claude/settings.local.json

# ---- ATAC analysis result CSVs (small/medium; committed so the ATAC panels reproduce) ----
!Src/ComboScreen/ATAC/CSV_Files/**/*.csv
# ...but NEVER the large regenerable matrices (exceed GitHub's 100MB limit or are bulky
#    intermediates that the figures don't read; regenerate via the R pipeline / export scripts).
Src/ComboScreen/ATAC/CSV_Files/ATAC_LSI.csv
Src/ComboScreen/ATAC/CSV_Files/PertPeaksFC.csv
Src/ComboScreen/ATAC/CSV_Files/PertPeaksFC_ptpeaks.csv
Src/ComboScreen/ATAC/CSV_Files/MotifMatrixTFGroups_hocomoco.csv
Src/ComboScreen/ATAC/CSV_Files/MotifMatrixTFGroups_hocomoco_pseudotime.csv
Src/ComboScreen/ATAC/CSV_Files/PseudotimePeaksFC.csv
